---
import PageLayout from '@/layouts/PageLayout.astro';
import { jadwalIbadah } from '@/data/jadwal-ibadah';

const hariOrder = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
const sorted = [...jadwalIbadah].sort(
  (a, b) => hariOrder.indexOf(a.hari) - hariOrder.indexOf(b.hari)
);
---

<PageLayout
  title="Jadwal Ibadah"
  description="Jadwal lengkap ibadah dan kegiatan pelayanan GPIB Benowo Surabaya setiap minggu."
>
  <section class="bg-brand-950 py-24">
    <div class="container-site">
      <div class="flex items-center gap-3 mb-4">
        <div class="h-px w-8 bg-gold-400"></div>
        <span class="text-gold-400 text-xs font-semibold tracking-widest uppercase">Ibadah</span>
      </div>
      <h1 class="font-display text-white">Jadwal Ibadah & Pelayanan</h1>
      <p class="text-brand-300 mt-4 max-w-xl">
        Bergabunglah bersama kami dalam berbagai ibadah dan kegiatan pelayanan setiap minggu. Semua jemaat disambut dengan hangat.
      </p>
    </div>
  </section>

  <section class="py-20">
    <div class="container-site max-w-3xl">
      <!-- Live stream notice -->
      <div class="flex items-start gap-4 p-4 rounded-2xl bg-red-50 border border-red-100 mb-10">
        <span class="flex items-center gap-1.5 text-xs font-semibold text-red-600 mt-0.5 shrink-0">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
          LIVE
        </span>
        <p class="text-sm text-red-700">
          Ibadah Minggu Pagi disiarkan langsung melalui YouTube.
          <a href="/media" class="font-semibold underline underline-offset-2">Tonton di sini →</a>
        </p>
      </div>

      <!-- Schedule cards -->
      <div class="space-y-3">
        {sorted.map((jadwal) => (
          <div class="flex items-center gap-5 p-5 rounded-2xl border border-stone-100 hover:border-brand-200 hover:bg-brand-50/20 transition-all group">
            <!-- Day badge -->
            <div class="w-16 h-16 rounded-xl bg-brand-950 flex flex-col items-center justify-center shrink-0">
              <span class="text-[10px] text-brand-300 uppercase tracking-wider">{jadwal.hari.substring(0, 3)}</span>
              <div class="w-4 h-px bg-gold-400 my-1"></div>
              <svg class="w-4 h-4 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z"/>
              </svg>
            </div>

            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="font-semibold text-stone-900">{jadwal.nama}</h3>
                {jadwal.isLive && (
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-red-100 text-red-600 border border-red-200 font-semibold">
                    ● LIVE
                  </span>
                )}
              </div>
              <p class="text-sm text-stone-500 mt-0.5">{jadwal.lokasi}</p>
              {jadwal.keterangan && (
                <p class="text-xs text-stone-400 mt-1">{jadwal.keterangan}</p>
              )}
            </div>

            <div class="text-right shrink-0">
              <div class="font-display font-semibold text-brand-700 text-lg">{jadwal.waktu}</div>
              <div class="text-xs text-stone-400">{jadwal.hari}</div>
            </div>
          </div>
        ))}
      </div>

      <!-- Note -->
      <p class="mt-8 text-sm text-stone-400 text-center">
        Jadwal dapat berubah pada hari-hari khusus (Natal, Paskah, dll.). Ikuti pengumuman resmi di media sosial kami.
      </p>
    </div>
  </section>
</PageLayout>
