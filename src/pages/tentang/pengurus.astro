---
import PageLayout from '@/layouts/PageLayout.astro';
import { pengurusGereja } from '@/data/pengurus';

const majelis = pengurusGereja.filter((p) => p.kategori === 'majelis');
const diakonia = pengurusGereja.filter((p) => p.kategori === 'diakonia');
---

<PageLayout
  title="Struktur Pengurus"
  description="Daftar pengurus dan majelis GPIB Benowo Surabaya yang melayani jemaat."
>
  <section class="bg-brand-950 py-24">
    <div class="container-site">
      <div class="flex items-center gap-3 mb-4">
        <div class="h-px w-8 bg-gold-400"></div>
        <span class="text-gold-400 text-xs font-semibold tracking-widest uppercase">Pengurus</span>
      </div>
      <h1 class="font-display text-white max-w-2xl">Hamba-hamba Tuhan yang melayani</h1>
    </div>
  </section>

  <nav class="bg-white border-b border-stone-100 sticky top-20 z-30">
    <div class="container-site">
      <div class="flex gap-1 overflow-x-auto">
        {[
          { label: 'Profil', href: '/tentang' },
          { label: 'Sejarah', href: '/tentang/sejarah' },
          { label: 'Visi & Misi', href: '/tentang/visi-misi' },
          { label: 'Pengurus', href: '/tentang/pengurus' },
        ].map((link) => (
          <a
            href={link.href}
            class:list={[
              'shrink-0 px-4 py-3 text-sm font-medium border-b-2 transition-colors',
              Astro.url.pathname === link.href
                ? 'border-brand-600 text-brand-700'
                : 'border-transparent text-stone-500 hover:text-stone-900',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </nav>

  <section class="py-20">
    <div class="container-site max-w-4xl space-y-16">
      <!-- Majelis -->
      <div>
        <h2 class="font-display text-brand-900 mb-8">Majelis Jemaat</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5">
          {majelis.map((p) => (
            <div class="text-center p-5 rounded-2xl border border-stone-100 hover:border-brand-200 hover:shadow-sm transition-all">
              <div class="w-16 h-16 rounded-full bg-brand-100 flex items-center justify-center text-brand-600 mx-auto mb-3">
                {p.foto ? (
                  <img src={p.foto} alt={p.nama} class="w-full h-full rounded-full object-cover" loading="lazy"/>
                ) : (
                  <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
                  </svg>
                )}
              </div>
              <div class="font-semibold text-stone-900 text-sm leading-snug">{p.nama}</div>
              <div class="text-xs text-stone-400 mt-1">{p.jabatan}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Diakonia -->
      {diakonia.length > 0 && (
        <div>
          <h2 class="font-display text-brand-900 mb-8">Tim Diakonia</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5">
            {diakonia.map((p) => (
              <div class="text-center p-5 rounded-2xl border border-stone-100 hover:border-brand-200 hover:shadow-sm transition-all">
                <div class="w-16 h-16 rounded-full bg-gold-100 flex items-center justify-center text-gold-600 mx-auto mb-3">
                  <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
                  </svg>
                </div>
                <div class="font-semibold text-stone-900 text-sm leading-snug">{p.nama}</div>
                <div class="text-xs text-stone-400 mt-1">{p.jabatan}</div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</PageLayout>
