---
import PageLayout from '@/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import SermonCard from '@/components/media/SermonCard.astro';
import { SITE } from '@/data/site';

const allKhotbah = await getCollection('khotbah', ({ data }) => !data.draft);
const latest = allKhotbah
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const liveEmbedUrl = `https://www.youtube-nocookie.com/embed/live_stream?channel=${SITE.youtubeChannelId}&autoplay=0&rel=0`;
---

<PageLayout
  title="Media & Streaming"
  description="Tonton ibadah GPIB Benowo Surabaya secara langsung atau arsip khotbah yang menguatkan iman."
>
  <section class="bg-brand-950 py-24">
    <div class="container-site">
      <div class="flex items-center gap-3 mb-4">
        <div class="h-px w-8 bg-gold-400"></div>
        <span class="text-gold-400 text-xs font-semibold tracking-widest uppercase">Media</span>
      </div>
      <h1 class="font-display text-white max-w-2xl">Ibadah Kapan Saja, Di Mana Saja</h1>
      <p class="text-brand-300 mt-4 max-w-xl">
        Saksikan ibadah secara langsung atau tonton arsip khotbah yang memberkati iman Anda.
      </p>
    </div>
  </section>

  <!-- Live stream section -->
  <section class="py-16 bg-stone-950">
    <div class="container-site">
      <div class="flex items-center gap-3 mb-8">
        <span class="flex items-center gap-1.5 text-sm font-semibold text-red-400">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
          Siaran Langsung
        </span>
        <span class="text-white/30 text-sm">Setiap Minggu Pagi, 07.00 WIB</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
        <!-- Live embed (no lazy — show immediately) -->
        <div class="lg:col-span-2">
          <div class="aspect-video rounded-2xl overflow-hidden bg-brand-900">
            <iframe
              src={liveEmbedUrl}
              title="Ibadah Live GPIB Benowo Surabaya"
              class="w-full h-full"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </div>

        <!-- Info sidebar -->
        <div class="text-white space-y-5">
          <div class="p-5 rounded-2xl bg-white/5 border border-white/10">
            <h3 class="font-display font-semibold text-lg mb-1">Ibadah Minggu Pagi</h3>
            <p class="text-white/50 text-sm mb-4">Setiap Minggu · 07.00 WIB</p>
            <a
              href={SITE.social.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-sm text-red-400 hover:text-red-300 transition-colors font-medium"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.5 6.2a3 3 0 00-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 00.5 6.2 31.5 31.5 0 000 12a31.5 31.5 0 00.5 5.8 3 3 0 002.1 2.1C4.5 20.5 12 20.5 12 20.5s7.5 0 9.4-.6a3 3 0 002.1-2.1A31.5 31.5 0 0024 12a31.5 31.5 0 00-.5-5.8zM9.7 15.5V8.5l6.3 3.5-6.3 3.5z"/>
              </svg>
              Tonton di YouTube
            </a>
          </div>

          <div class="p-5 rounded-2xl bg-white/5 border border-white/10">
            <h3 class="text-sm font-semibold text-white/60 uppercase tracking-wider mb-3">Jadwal Siaran Langsung</h3>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between text-white/70">
                <span>Ibadah Minggu Pagi</span>
                <span class="text-gold-400 font-medium">07.00 WIB</span>
              </div>
              <div class="flex justify-between text-white/70">
                <span>Ibadah Minggu Sore</span>
                <span class="text-white/30">Tidak disiarkan</span>
              </div>
              <div class="flex justify-between text-white/70">
                <span>Ibadah Khusus</span>
                <span class="text-gold-400 font-medium">Sesuai jadwal</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Recent sermons -->
  {latest.length > 0 && (
    <section class="py-16 bg-brand-950">
      <div class="container-site">
        <div class="flex items-end justify-between gap-4 mb-10">
          <div>
            <div class="flex items-center gap-3 mb-3">
              <div class="h-px w-8 bg-gold-400"></div>
              <span class="text-gold-400 text-xs font-semibold tracking-widest uppercase">Arsip</span>
            </div>
            <h2 class="font-display text-white">Khotbah Terbaru</h2>
          </div>
          <a href="/media/khotbah" class="text-sm text-brand-300 hover:text-white transition-colors shrink-0">
            Lihat semua →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {latest.map((k) => (
            <SermonCard
              href={`/media/khotbah/${k.id}`}
              title={k.data.title}
              description={k.data.description}
              pubDate={k.data.pubDate}
              preacher={k.data.preacher}
              ayat={k.data.ayat}
              youtubeId={k.data.youtubeId}
              duration={k.data.duration}
              ibadah={k.data.ibadah}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</PageLayout>
