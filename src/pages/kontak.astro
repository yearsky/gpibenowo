---
import PageLayout from '@/layouts/PageLayout.astro';
import { SITE } from '@/data/site';
---

<PageLayout
  title="Hubungi Kami"
  description="Alamat, nomor telepon, dan cara menghubungi GPIB Benowo Surabaya."
>
  <section class="bg-brand-950 py-24">
    <div class="container-site">
      <div class="flex items-center gap-3 mb-4">
        <div class="h-px w-8 bg-gold-400"></div>
        <span class="text-gold-400 text-xs font-semibold tracking-widest uppercase">Kontak</span>
      </div>
      <h1 class="font-display text-white">Kami senang mendengar dari Anda</h1>
    </div>
  </section>

  <section class="py-20">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <!-- Contact info -->
        <div class="space-y-8">
          <div>
            <h2 class="font-display text-brand-900 mb-6">Informasi Kontak</h2>
            <div class="space-y-5">
              {[
                {
                  icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>`,
                  label: 'Alamat',
                  value: SITE.contact.address,
                  href: SITE.contact.mapsUrl,
                },
                {
                  icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>`,
                  label: 'Telepon',
                  value: SITE.contact.phone,
                  href: `tel:${SITE.contact.phone}`,
                },
                {
                  icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>`,
                  label: 'Email',
                  value: SITE.contact.email,
                  href: `mailto:${SITE.contact.email}`,
                },
              ].map((item) => (
                <div class="flex gap-4">
                  <div class="w-10 h-10 rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 shrink-0" set:html={item.icon} />
                  <div>
                    <div class="text-xs text-stone-400 font-medium mb-1">{item.label}</div>
                    <a href={item.href} target="_blank" rel="noopener noreferrer"
                      class="text-stone-800 hover:text-brand-600 transition-colors text-sm">
                      {item.value}
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Jam Kantor -->
          <div class="p-6 rounded-2xl bg-stone-50 border border-stone-100">
            <h3 class="font-semibold text-stone-900 mb-4">Jam Kantor Sekretariat</h3>
            <div class="space-y-2 text-sm">
              {[
                { hari: 'Senin – Jumat', jam: '08.00 – 16.00 WIB' },
                { hari: 'Sabtu', jam: '08.00 – 12.00 WIB' },
                { hari: 'Minggu', jam: 'Tutup (hari ibadah)' },
              ].map((item) => (
                <div class="flex justify-between text-stone-600">
                  <span>{item.hari}</span>
                  <span class="font-medium">{item.jam}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Social -->
          <div>
            <h3 class="font-semibold text-stone-900 mb-4">Ikuti Kami</h3>
            <div class="flex gap-3">
              {[
                { label: 'YouTube', href: SITE.social.youtube, color: 'bg-red-600' },
                { label: 'Instagram', href: SITE.social.instagram, color: 'bg-pink-600' },
                { label: 'Facebook', href: SITE.social.facebook, color: 'bg-blue-700' },
              ].map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={['px-4 py-2 rounded-full text-white text-xs font-semibold transition-opacity hover:opacity-80', s.color]}
                >
                  {s.label}
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Map embed placeholder -->
        <div class="rounded-3xl overflow-hidden border border-stone-200 bg-stone-100 min-h-80 flex flex-col items-center justify-center gap-4 text-center p-8">
          <div class="w-16 h-16 rounded-full bg-brand-100 flex items-center justify-center">
            <svg class="w-8 h-8 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-stone-700 mb-1">Temukan kami di Google Maps</p>
            <p class="text-sm text-stone-400 mb-4">{SITE.contact.address}</p>
            <a
              href={SITE.contact.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-full transition-colors"
            >
              Buka Google Maps
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
