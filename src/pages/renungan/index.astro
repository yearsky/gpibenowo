---
import PageLayout from '@/layouts/PageLayout.astro';
import PostCard from '@/components/blog/PostCard.astro';
import { getCollection } from 'astro:content';

const allRenungan = await getCollection('renungan', ({ data }) => !data.draft);
const sorted = allRenungan.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<PageLayout
  title="Renungan Harian"
  description="Renungan harian GPIB Benowo Surabaya — pengantar firman Tuhan untuk menguatkan iman setiap hari."
>
  <section class="bg-brand-950 py-24 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04] pointer-events-none" aria-hidden="true">
      <svg viewBox="0 0 200 200" class="w-80 h-80 absolute -left-10 -bottom-10" fill="none">
        <line x1="100" y1="0" x2="100" y2="200" stroke="white" stroke-width="1"/>
        <line x1="0" y1="70" x2="200" y2="70" stroke="white" stroke-width="1"/>
      </svg>
    </div>
    <div class="container-site relative">
      <div class="flex items-center gap-3 mb-4">
        <div class="h-px w-8 bg-gold-400"></div>
        <span class="text-gold-400 text-xs font-semibold tracking-widest uppercase">Firman Tuhan</span>
      </div>
      <h1 class="font-display text-white max-w-2xl">Renungan Harian</h1>
      <p class="text-brand-300 mt-4 max-w-xl">
        Pengantar firman Tuhan setiap hari untuk menguatkan iman, memberi pengharapan, dan mendekatkan diri kepada-Nya.
      </p>

      <!-- RSS link -->
      <a
        href="/rss.xml"
        class="inline-flex items-center gap-2 mt-6 text-xs text-brand-300 hover:text-gold-300 transition-colors"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6.18 15.64a2.18 2.18 0 012.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 012.18-2.18M4 4.44A15.56 15.56 0 0119.56 20h-2.83A12.73 12.73 0 004 7.27V4.44m0 5.66a9.9 9.9 0 019.9 9.9h-2.83A7.07 7.07 0 004 12.93V10.1z"/>
        </svg>
        Berlangganan via RSS
      </a>
    </div>
  </section>

  <section class="py-16">
    <div class="container-site">
      {sorted.length === 0 ? (
        <p class="text-center text-stone-400 py-16">Belum ada renungan tersedia.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {sorted.map((post, i) => (
            <PostCard
              href={`/renungan/${post.id}`}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              author={post.data.author}
              ayat={post.data.ayat}
              tags={post.data.tags}
              variant="renungan"
              index={i}
            />
          ))}
        </div>
      )}
    </div>
  </section>
</PageLayout>
