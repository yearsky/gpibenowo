---
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  author?: string;
  noindex?: boolean;
  fullWidth?: boolean;
  heroPage?: boolean;
}

const { fullWidth = false, heroPage = false, ...rest } = Astro.props;
---

<BaseLayout {...rest}>
  <Header />
  <main class:list={[{ 'pt-20': !heroPage }]}>
    <slot />
  </main>
  <Footer />
</BaseLayout>
