---
import PageLayout from './PageLayout.astro';
import { formatDate } from '@/utils/date';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author?: string;
  ayat?: string;
  image?: string;
  tags?: string[];
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  description,
  pubDate,
  author,
  ayat,
  image,
  tags = [],
  backHref = '/',
  backLabel = 'Kembali',
} = Astro.props;
---

<PageLayout title={title} description={description} image={image} type="article" {pubDate} {author}>
  <article class="container-site py-16 max-w-3xl">
    <!-- Back link -->
    <a
      href={backHref}
      class="inline-flex items-center gap-2 text-sm text-brand-500 hover:text-brand-700 mb-8 transition-colors"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
      {backLabel}
    </a>

    <!-- Article header -->
    <header class="mb-10">
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-4">
          {tags.map((tag) => (
            <span class="text-xs px-3 py-1 rounded-full bg-gold-100 text-gold-700 font-medium">
              {tag}
            </span>
          ))}
        </div>
      )}

      <h1 class="font-display text-brand-950 mb-4">{title}</h1>

      <!-- Bible verse -->
      {ayat && (
        <div class="verse-block my-6">
          <p class="text-sm font-medium not-italic text-gold-600 font-body mb-1">{ayat}</p>
        </div>
      )}

      <!-- Meta -->
      <div class="flex flex-wrap items-center gap-4 text-sm text-stone-500 pt-4 border-t border-stone-200">
        <time datetime={pubDate.toISOString()}>
          {formatDate(pubDate)}
        </time>
        {author && (
          <>
            <span class="text-stone-300">·</span>
            <span>{author}</span>
          </>
        )}
      </div>
    </header>

    <!-- Article body -->
    <div class="prose prose-lg max-w-none
      prose-headings:font-display prose-headings:text-brand-900
      prose-a:text-brand-600 prose-a:no-underline hover:prose-a:underline
      prose-blockquote:border-gold-400 prose-blockquote:text-brand-800 prose-blockquote:font-verse prose-blockquote:italic
      prose-strong:text-stone-900
      prose-hr:border-stone-200">
      <slot />
    </div>

    <!-- Tags footer -->
    {tags.length > 0 && (
      <div class="mt-12 pt-8 border-t border-stone-200 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="text-xs px-3 py-1.5 rounded-full border border-stone-200 text-stone-500">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </article>
</PageLayout>
