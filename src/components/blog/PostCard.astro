---
import { formatDate } from '@/utils/date';

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  author?: string;
  ayat?: string;
  category?: string;
  categoryLabel?: string;
  tags?: string[];
  variant?: 'renungan' | 'berita';
  index?: number;
}

const {
  href,
  title,
  description,
  pubDate,
  author,
  ayat,
  category,
  categoryLabel,
  tags = [],
  variant = 'renungan',
  index = 0,
} = Astro.props;

const borderColors = ['border-gold-400', 'border-gold-300', 'border-gold-200', 'border-brand-300'];
const borderColor = borderColors[index % borderColors.length];
---

<a
  href={href}
  class:list={[
    'group block rounded-r-2xl border-l-4 p-6 bg-white hover:shadow-md transition-all h-full flex flex-col',
    variant === 'renungan' ? borderColor : 'border-brand-400',
  ]}
>
  <!-- Date + category -->
  <div class="flex items-center justify-between mb-3">
    <time datetime={pubDate.toISOString()} class="text-xs text-stone-400 font-medium">
      {formatDate(pubDate)}
    </time>
    {categoryLabel && (
      <span class="text-xs px-2.5 py-0.5 rounded-full bg-brand-50 text-brand-700 font-semibold">
        {categoryLabel}
      </span>
    )}
  </div>

  <!-- Ayat ref (renungan only) -->
  {ayat && (
    <div class="text-xs text-gold-600 font-semibold mb-2 font-verse italic">{ayat}</div>
  )}

  <!-- Title -->
  <h3 class="font-display font-semibold text-brand-900 text-lg leading-snug mb-2 group-hover:text-brand-600 transition-colors flex-1">
    {title}
  </h3>

  <!-- Description -->
  <p class="text-sm text-stone-500 leading-relaxed line-clamp-2 mb-4">
    {description}
  </p>

  <!-- Footer -->
  <div class="pt-4 border-t border-stone-100 flex items-center justify-between">
    {author && <span class="text-xs text-stone-400">{author}</span>}
    <svg class="w-4 h-4 text-brand-400 group-hover:translate-x-1 transition-transform ml-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
    </svg>
  </div>
</a>
