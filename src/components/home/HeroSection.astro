---
import { jadwalIbadah } from '@/data/jadwal-ibadah';

const nextSunday = jadwalIbadah.find(j => j.id === 'minggu-pagi');
---

<section id="beranda" class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-marble"></div>
    <div class="hero-overlay"></div>
  </div>

  <div class="container-site hero-inner">
    <div class="hero-eyebrow">
      <span class="eyebrow-dash"></span>
      GPIB Benowo · Surabaya · Est. 1979
    </div>

    <h1 class="hero-title">
      Bersatu dalam Kasih,<br/>
      <em>Bertumbuh dalam Iman.</em>
    </h1>

    <p class="hero-lead">
      Tempat ibadah, persekutuan, dan pertumbuhan rohani bagi seluruh jemaat
      Gereja Protestan di Indonesia bagian Barat — Jemaat Benowo, Surabaya.
    </p>

    <div class="hero-actions">
      <a href="/ibadah" class="btn btn-gold">
        Lihat Jadwal Ibadah
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M13 5l7 7-7 7"/>
        </svg>
      </a>
      <a href="/renungan" class="btn btn-ghost-light">Baca Renungan Hari Ini</a>
    </div>

    <div class="hero-meta">
      <div class="hm-item">
        <div class="hm-label">Ibadah Berikutnya</div>
        <div class="hm-value">Minggu · {nextSunday?.waktu ?? '07.00 WIB'}</div>
      </div>
      <div class="hm-divider"></div>
      <div class="hm-item">
        <div class="hm-label">Live Streaming</div>
        <div class="hm-value">YouTube · @gpibbenowo</div>
      </div>
      <div class="hm-divider"></div>
      <div class="hm-item">
        <div class="hm-label">Lokasi</div>
        <div class="hm-value">Pakal, Surabaya — Jawa Timur</div>
      </div>
    </div>
  </div>
</section>
