---
import { jadwalIbadah } from '@/data/jadwal-ibadah';

const HARI_ORDER = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
const sorted = [...jadwalIbadah].sort(
  (a, b) => HARI_ORDER.indexOf(a.hari) - HARI_ORDER.indexOf(b.hari)
);
const uniqueHari = [...new Set(sorted.map(j => j.hari))];
---

<section id="ibadah" class="section">
  <div class="container-site">
    <div class="section-header">
      <img src="/laurel-wreath.svg" alt="" class="section-wreath" aria-hidden="true" />
      <div class="eyebrow">Jadwal Mingguan</div>
      <h2 class="section-title">Jadwal Ibadah</h2>
      <p class="section-subtitle">
        Bergabunglah dalam ibadah dan persekutuan jemaat sepanjang minggu di Gedung Gereja GPIB Benowo.
      </p>
    </div>

    <div class="filter-chips" id="jadwal-filters" role="tablist" aria-label="Filter jadwal">
      <button role="tab" aria-selected="true" class="chip chip-active" data-filter="Semua">Semua</button>
      {uniqueHari.map(h => (
        <button role="tab" aria-selected="false" class="chip" data-filter={h}>{h}</button>
      ))}
    </div>

    <ul class="jadwal-list" id="jadwal-list">
      {sorted.map(row => (
        <li class="jadwal-row" data-hari={row.hari}>
          <div class="jadwal-day">
            <span class="jadwal-hari">{row.hari}</span>
            <span class="today-tag" style="display:none">Hari Ini</span>
          </div>
          <div class="jadwal-meta">
            <h3 class="jadwal-nama">{row.nama}</h3>
            <div class="jadwal-loc">{row.lokasi}</div>
          </div>
          <div class="jadwal-time">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            {row.waktu}
          </div>
          <div class="jadwal-action">
            {row.isLive ? (
              <span class="live-badge">
                <span class="live-dot"></span>Live Sekarang
              </span>
            ) : (
              <a href="/ibadah" class="link-arrow">
                Detail
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 5l7 7-7 7"/>
                </svg>
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>

    <div style="text-align:center; margin-top: 32px;">
      <a href="/ibadah" class="link-arrow link-arrow-lg">
        Lihat Jadwal Lengkap
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  const HARI_ID = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
  const todayIdx = new Date().getDay();
  const todayHari = HARI_ID[todayIdx];

  const filters = document.querySelectorAll<HTMLButtonElement>('#jadwal-filters .chip');
  const rows = document.querySelectorAll<HTMLLIElement>('#jadwal-list .jadwal-row');

  // Highlight today's rows
  rows.forEach(row => {
    if (row.dataset.hari === todayHari) {
      row.classList.add('is-today');
      const tag = row.querySelector('.today-tag') as HTMLElement | null;
      if (tag) tag.style.display = '';
    }
  });

  // Filter chip logic
  function setFilter(filter: string) {
    filters.forEach(btn => {
      const active = btn.dataset.filter === filter;
      btn.classList.toggle('chip-active', active);
      btn.setAttribute('aria-selected', String(active));
    });
    rows.forEach(row => {
      const show = filter === 'Semua' || row.dataset.hari === filter;
      (row as HTMLElement).style.display = show ? '' : 'none';
    });
  }

  filters.forEach(btn => {
    btn.addEventListener('click', () => setFilter(btn.dataset.filter ?? 'Semua'));
  });
</script>
