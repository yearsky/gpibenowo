---
import { getCollection } from 'astro:content';
import { formatDate } from '@/utils/date';

const all = await getCollection('renungan', ({ data }) => !data.draft);
const sorted = all.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const featured = sorted.find(r => r.data.featured) ?? sorted[0];
const rest = sorted.filter(r => r !== featured).slice(0, 2);

function initials(name: string) {
  return name.split(/\s+/).filter(Boolean).slice(0, 2).map(w => w[0]).join('').toUpperCase();
}
---

{featured && (
  <section id="renungan" class="section section-tinted">
    <div class="container-site">
      <div class="renungan-grid">
        <!-- Left: meta + CTA -->
        <aside class="renungan-meta">
          <div class="eyebrow">Renungan Hari Ini</div>
          <h2 class="renungan-title">{featured.data.title}</h2>
          <div class="renungan-attr">
            <div class="avatar">{initials(featured.data.author)}</div>
            <div>
              <div class="attr-name">{featured.data.author}</div>
              <div class="attr-meta">
                {formatDate(featured.data.pubDate)}
              </div>
            </div>
          </div>
          <a href={`/renungan/${featured.id}`} class="btn btn-navy">
            Baca Selengkapnya
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7"/>
            </svg>
          </a>

          {rest.length > 0 && (
            <div style="margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--border-hairline);">
              <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.14em; color:var(--fg-muted); margin-bottom:12px;">Renungan Lainnya</div>
              {rest.map(r => (
                <a href={`/renungan/${r.id}`} style="display:block; margin-bottom:12px; text-decoration:none;">
                  <div style="font-family: var(--font-display); font-size:14px; font-weight:600; color:var(--color-brand-900); line-height:1.3; margin-bottom:3px;">{r.data.title}</div>
                  <div style="font-size:12px; color:var(--fg-muted);">{formatDate(r.data.pubDate)}</div>
                </a>
              ))}
            </div>
          )}
        </aside>

        <!-- Right: article body -->
        <article class="renungan-body">
          <blockquote class="verse-block">
            "{featured.data.description}"
          </blockquote>
          <div class="verse-credit">— {featured.data.ayat}</div>

          <p>
            {featured.data.description}
          </p>

          {featured.data.tags.length > 0 && (
            <div class="tag-pile">
              {featured.data.tags.map(tag => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          )}
        </article>
      </div>
    </div>
  </section>
)}
