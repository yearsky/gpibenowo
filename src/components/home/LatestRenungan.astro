---
import { getCollection } from 'astro:content';
import { formatDate } from '@/utils/date';

const allRenungan = await getCollection('renungan', ({ data }) => !data.draft);
const sorted = allRenungan.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const latest = sorted.slice(0, 3);
---

<section class="py-24 bg-stone-50">
  <div class="container-site">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="h-px w-8 bg-gold-400"></div>
          <span class="text-gold-600 text-xs font-semibold tracking-widest uppercase">Firman Tuhan</span>
        </div>
        <h2 class="font-display text-brand-900">Renungan Harian</h2>
      </div>
      <a href="/renungan" class="text-sm text-brand-600 hover:text-brand-800 font-medium transition-colors shrink-0">
        Semua renungan →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {latest.map((post, i) => (
        <a
          href={`/renungan/${post.id}`}
          class:list={[
            'group block bg-stone-50 border-l-4 rounded-r-2xl p-6 hover:shadow-md transition-all',
            { 'border-gold-400': i === 0, 'border-gold-300': i === 1, 'border-gold-200': i === 2 }
          ]}
          style="background: white;"
        >
          <!-- Date stamp -->
          <time
            datetime={post.data.pubDate.toISOString()}
            class="block text-xs text-stone-400 mb-3 font-medium"
          >
            {formatDate(post.data.pubDate)}
          </time>

          <!-- Bible verse ref -->
          <div class="text-xs text-gold-600 font-semibold mb-2 font-verse italic">
            {post.data.ayat}
          </div>

          <!-- Title -->
          <h3 class="font-display font-semibold text-brand-900 text-lg leading-snug mb-2 group-hover:text-brand-600 transition-colors">
            {post.data.title}
          </h3>

          <!-- Description -->
          <p class="text-sm text-stone-500 leading-relaxed line-clamp-2">
            {post.data.description}
          </p>

          <!-- Author -->
          <div class="mt-4 pt-4 border-t border-stone-100 flex items-center justify-between">
            <span class="text-xs text-stone-400">{post.data.author}</span>
            <svg class="w-4 h-4 text-brand-400 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
