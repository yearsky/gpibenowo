---
import { getCollection } from 'astro:content';
import { formatDate } from '@/utils/date';

const all = await getCollection('berita', ({ data }) => !data.draft);
const sorted = all.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const latest = sorted.slice(0, 3);

const categoryLabel: Record<string, string> = {
  warta: 'Warta',
  kegiatan: 'Kegiatan',
  pengumuman: 'Pengumuman',
  jemaat: 'Jemaat',
};

function imgClass(category: string) {
  if (category === 'kegiatan') return 'berita-img-gold';
  if (category === 'warta') return 'berita-img-navy';
  return 'berita-img-video';
}
---

{latest.length > 0 && (
  <section id="berita" class="section">
    <div class="container-site">
      <div class="section-header section-header-row">
        <div>
          <div class="eyebrow">Berita &amp; Warta</div>
          <h2 class="section-title" style="margin-bottom:0">Kabar Terbaru Jemaat</h2>
        </div>
        <a href="/berita" class="link-arrow link-arrow-lg">
          Semua Berita
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <div class="berita-grid">
        {latest.map((post) => (
          <a href={`/berita/${post.id}`} class="berita-card">
            <div class:list={['berita-img', imgClass(post.data.category)]}>
              {post.data.category !== 'kegiatan' && post.data.category !== 'warta' && (
                <div class="play-btn" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                    <polygon points="6 4 20 12 6 20 6 4"/>
                  </svg>
                </div>
              )}
            </div>
            <div class="berita-body">
              <div class="berita-meta">
                <span class:list={['badge', `badge-${post.data.category}`]}>
                  {categoryLabel[post.data.category] ?? post.data.category}
                </span>
                <span class="berita-date">{formatDate(post.data.pubDate)}</span>
              </div>
              <h3 class="berita-title">{post.data.title}</h3>
              <p class="berita-desc">{post.data.description}</p>
              <span class="link-arrow" style="margin-top:auto">
                Baca
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
