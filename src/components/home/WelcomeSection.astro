---
---

<section class="py-24 bg-stone-50">
  <div class="container-site">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Text content -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="h-px w-8 bg-gold-400"></div>
          <span class="text-gold-600 text-xs font-semibold tracking-widest uppercase">Selamat Datang</span>
        </div>
        <h2 class="font-display text-brand-900 mb-6">
          Rumah bagi setiap jiwa yang mencari Tuhan
        </h2>
        <p class="text-stone-600 leading-relaxed mb-4">
          GPIB Benowo Surabaya adalah jemaat dari Gereja Protestan di Indonesia bagian Barat yang telah melayani masyarakat Surabaya sejak 1968. Kami percaya bahwa gereja adalah komunitas kasih yang terbuka bagi semua orang.
        </p>
        <p class="text-stone-600 leading-relaxed mb-8">
          Dalam persekutuan kami, setiap orang disambut dengan hangat — dari anak-anak hingga lansia, dari yang sudah lama beriman hingga yang baru mencari. Bersama-sama kami bertumbuh dalam pengenalan akan Tuhan.
        </p>
        <a
          href="/tentang"
          class="inline-flex items-center gap-2 text-brand-600 font-semibold hover:text-brand-800 transition-colors group"
        >
          Pelajari lebih lanjut
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

      <!-- Feature cards -->
      <div class="grid grid-cols-2 gap-4">
        {[
          {
            icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>`,
            title: 'Ibadah',
            desc: 'Berbagai ibadah tersedia untuk seluruh jemaat setiap minggu'
          },
          {
            icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
            title: 'Persekutuan',
            desc: 'Kelompok kecil untuk bertumbuh bersama dalam iman dan kasih'
          },
          {
            icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>`,
            title: 'Diakonia',
            desc: 'Melayani dan memberi kepada sesama yang membutuhkan'
          },
          {
            icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>`,
            title: 'Pengajaran',
            desc: 'Renungan dan khotbah yang mendalam untuk pertumbuhan rohani'
          },
        ].map((item) => (
          <div class="p-5 rounded-2xl bg-white border border-stone-100 hover:border-brand-200 hover:shadow-sm transition-all group">
            <div class="w-10 h-10 rounded-xl bg-brand-50 flex items-center justify-center text-brand-600 mb-3 group-hover:bg-brand-100 transition-colors" set:html={item.icon} />
            <h3 class="font-semibold text-stone-900 text-base mb-1">{item.title}</h3>
            <p class="text-xs text-stone-500 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
