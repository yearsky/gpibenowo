---
import { SITE } from '@/data/site';

const year = new Date().getFullYear();

const quickLinks = [
  { label: 'Tentang Kami', href: '/tentang' },
  { label: 'Jadwal Ibadah', href: '/ibadah' },
  { label: 'Renungan Harian', href: '/renungan' },
  { label: 'Berita Jemaat', href: '/berita' },
  { label: 'Media & Streaming', href: '/media' },
  { label: 'Hubungi Kami', href: '/kontak' },
];
---

<footer class="bg-brand-950 text-white">
  <!-- Wave divider -->
  <div class="wave-divider" aria-hidden="true">
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" class="w-full h-12 lg:h-16 fill-stone-50">
      <path d="M0,0 C360,60 1080,60 1440,0 L1440,0 L0,0 Z"/>
    </svg>
  </div>

  <div class="container-site pb-12">
    <!-- Main footer grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 py-10 border-b border-white/10">
      <!-- Brand column -->
      <div class="md:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 shrink-0">
            <rect width="40" height="40" rx="8" fill="#1a3a6e"/>
            <line x1="20" y1="7" x2="20" y2="33" stroke="#f59e0b" stroke-width="4" stroke-linecap="round"/>
            <line x1="10" y1="15" x2="30" y2="15" stroke="#f59e0b" stroke-width="4" stroke-linecap="round"/>
          </svg>
          <div>
            <div class="font-display font-bold text-lg leading-tight">GPIB Benowo</div>
            <div class="text-xs text-brand-300 tracking-widest uppercase">Surabaya</div>
          </div>
        </div>
        <p class="text-sm text-white/60 leading-relaxed mb-6">
          Gereja Protestan di Indonesia bagian Barat – Jemaat Benowo Surabaya. Bersatu dalam kasih, bertumbuh dalam iman.
        </p>
        <!-- Social links -->
        <div class="flex gap-3">
          <a href={SITE.social.youtube} target="_blank" rel="noopener noreferrer"
            class="w-9 h-9 flex items-center justify-center rounded-full bg-white/10 hover:bg-gold-500 hover:text-stone-950 transition-all text-white/70"
            aria-label="YouTube">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.5 6.2a3 3 0 00-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 00.5 6.2 31.5 31.5 0 000 12a31.5 31.5 0 00.5 5.8 3 3 0 002.1 2.1C4.5 20.5 12 20.5 12 20.5s7.5 0 9.4-.6a3 3 0 002.1-2.1A31.5 31.5 0 0024 12a31.5 31.5 0 00-.5-5.8zM9.7 15.5V8.5l6.3 3.5-6.3 3.5z"/>
            </svg>
          </a>
          <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer"
            class="w-9 h-9 flex items-center justify-center rounded-full bg-white/10 hover:bg-gold-500 hover:text-stone-950 transition-all text-white/70"
            aria-label="Instagram">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.2c3.2 0 3.6 0 4.9.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8 0 3.2 0 3.6-.1 4.8-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.9.1-3.2 0-3.6 0-4.8-.1-3.3-.1-4.8-1.7-4.9-4.9C2.2 15.6 2.2 15.3 2.2 12c0-3.2 0-3.5.1-4.8C2.4 3.9 4 2.3 7.2 2.3 8.5 2.2 8.8 2.2 12 2.2zm0-2.2C8.7 0 8.3 0 7.1.1 2.7.3.3 2.7.1 7.1 0 8.3 0 8.7 0 12c0 3.3 0 3.7.1 4.9.2 4.4 2.6 6.8 7 7C8.3 24 8.7 24 12 24c3.3 0 3.7 0 4.9-.1 4.4-.2 6.8-2.6 7-7 .1-1.2.1-1.6.1-4.9 0-3.3 0-3.7-.1-4.9C23.7 2.7 21.3.3 16.9.1 15.7 0 15.3 0 12 0zm0 5.8a6.2 6.2 0 100 12.4A6.2 6.2 0 0012 5.8zm0 10.2a4 4 0 110-8 4 4 0 010 8zm6.4-11.8a1.4 1.4 0 100 2.8 1.4 1.4 0 000-2.8z"/>
            </svg>
          </a>
          <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer"
            class="w-9 h-9 flex items-center justify-center rounded-full bg-white/10 hover:bg-gold-500 hover:text-stone-950 transition-all text-white/70"
            aria-label="Facebook">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M22.7 0H1.3C.6 0 0 .6 0 1.3v21.4C0 23.4.6 24 1.3 24H12.8v-9.3H9.7V11h3.1V8.4c0-3.1 1.9-4.8 4.7-4.8 1.3 0 2.7.1 4 .2v3.2h-2.7c-1.5 0-1.8.7-1.8 1.8V11h3.6l-.5 3.7h-3.1V24h6.7c.7 0 1.3-.6 1.3-1.3V1.3C24 .6 23.4 0 22.7 0z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-widest text-gold-400 mb-5">Navigasi</h3>
        <ul class="space-y-2.5">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-white/60 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact info -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-widest text-gold-400 mb-5">Kontak</h3>
        <ul class="space-y-4 text-sm text-white/60">
          <li class="flex gap-3">
            <svg class="w-4 h-4 shrink-0 mt-0.5 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>{SITE.contact.address}</span>
          </li>
          <li class="flex gap-3 items-center">
            <svg class="w-4 h-4 shrink-0 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href={`tel:${SITE.contact.phone}`} class="hover:text-white transition-colors">{SITE.contact.phone}</a>
          </li>
          <li class="flex gap-3 items-center">
            <svg class="w-4 h-4 shrink-0 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href={`mailto:${SITE.contact.email}`} class="hover:text-white transition-colors">{SITE.contact.email}</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-white/40">
      <p>&copy; {year} {SITE.name}. Semua hak dilindungi.</p>
      <p>Dibangun dengan <span class="text-gold-500">&#9829;</span> untuk jemaat Tuhan</p>
    </div>
  </div>
</footer>
