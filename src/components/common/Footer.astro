---
import { SITE } from '@/data/site';

const year = new Date().getFullYear();
---

<footer id="kontak-footer" class="site-footer">
  <div class="container-site">
    <!-- Greek key meander ornament -->
    <img src="/greek-key-divider.svg" alt="" class="footer-meander" aria-hidden="true" />

    <div class="footer-grid">
      <!-- Brand -->
      <div>
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:4px;">
          <img src="/logo-cross.svg" alt="" width="38" height="38" />
          <div>
            <div class="footer-brand-name">GPIB Benowo</div>
            <div class="footer-brand-sub">Surabaya</div>
          </div>
        </div>
        <p class="footer-tagline"><em>Bersatu dalam Kasih, Bertumbuh dalam Iman.</em></p>
      </div>

      <!-- Navigation -->
      <div class="footer-col">
        <div class="col-title">Jelajahi</div>
        <a href="/tentang">Tentang Gereja</a>
        <a href="/tentang/visi-misi">Visi &amp; Misi</a>
        <a href="/tentang/pengurus">Pengurus Majelis</a>
        <a href="/renungan">Renungan</a>
        <a href="/berita">Berita</a>
        <a href="/media">Media</a>
      </div>

      <!-- Contact -->
      <div class="footer-col">
        <div class="col-title">Hubungi</div>
        <p class="footer-addr">{SITE.contact.address}</p>
        <a href={`tel:${SITE.contact.phone}`}>{SITE.contact.phone}</a>
        <a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>
      </div>

      <!-- Newsletter -->
      <div class="footer-col">
        <div class="col-title">Newsletter Mingguan</div>
        <p class="footer-addr">Renungan dan jadwal ibadah dikirim setiap Minggu pagi.</p>
        <form class="newsletter-row" onsubmit="return false;" aria-label="Berlangganan newsletter">
          <input
            class="newsletter-input"
            type="email"
            placeholder="email@anda.com"
            required
            aria-label="Alamat email"
          />
          <button class="btn btn-gold btn-sm" type="submit">Kirim</button>
        </form>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <div class="footer-copyright">&copy; {year} {SITE.name}. Semua hak dilindungi.</div>
      <div class="footer-social">
        <a href={SITE.social.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.6 3.5 12 3.5 12 3.5s-7.6 0-9.4.6A3 3 0 0 0 .5 6.2 31.5 31.5 0 0 0 0 12a31.5 31.5 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.8.6 9.4.6 9.4.6s7.6 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.5 31.5 0 0 0 24 12a31.5 31.5 0 0 0-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/>
          </svg>
        </a>
        <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"/>
          </svg>
        </a>
        <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M14 9h3V6h-3a4 4 0 0 0-4 4v2H7v3h3v7h3v-7h3l1-3h-4v-2a1 1 0 0 1 1-1z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
