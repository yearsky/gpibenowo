---
import { SITE } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  author?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = SITE.defaultOgImage,
  type = 'website',
  pubDate,
  author,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.shortName}` : SITE.name;
const canonicalURL = new URL(Astro.url.pathname, SITE.url);
const ogImage = new URL(image, SITE.url).toString();

const jsonLdOrg = {
  '@context': 'https://schema.org',
  '@type': 'Church',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Jl. Benowo No. 1',
    addressLocality: 'Surabaya',
    addressRegion: 'Jawa Timur',
    postalCode: '60198',
    addressCountry: 'ID',
  },
  telephone: SITE.contact.phone,
  email: SITE.contact.email,
  sameAs: Object.values(SITE.social),
};

const jsonLdArticle = type === 'article' && pubDate ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: ogImage,
  datePublished: pubDate.toISOString(),
  author: {
    '@type': 'Person',
    name: author ?? SITE.name,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
} : null;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex,nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="id_ID" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Article meta -->
{type === 'article' && pubDate && (
  <meta property="article:published_time" content={pubDate.toISOString()} />
)}
{type === 'article' && author && (
  <meta property="article:author" content={author} />
)}

<!-- JSON-LD -->
{type === 'website' && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdOrg)} />
)}
{jsonLdArticle && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdArticle)} />
)}
