---
import { navItems } from '@/data/navigation';
import { SITE } from '@/data/site';

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  style="background: transparent;"
>
  <div class="container-site">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group" aria-label={SITE.name}>
        <div class="relative w-10 h-10 shrink-0">
          <!-- Geometric cross logo -->
          <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
            <rect width="40" height="40" rx="8" fill="#0f2044"/>
            <line x1="20" y1="7" x2="20" y2="33" stroke="#f59e0b" stroke-width="4" stroke-linecap="round"/>
            <line x1="10" y1="15" x2="30" y2="15" stroke="#f59e0b" stroke-width="4" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="text-white">
          <div class="font-display font-bold text-base leading-tight group-hover:text-gold-300 transition-colors">
            GPIB Benowo
          </div>
          <div class="text-[11px] text-brand-300 font-body tracking-wider uppercase opacity-80">
            Surabaya
          </div>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Navigasi utama">
        {navItems.map((item) => {
          const isActive = currentPath.startsWith(item.href) && item.href !== '/';
          const isHome = item.href === '/' && currentPath === '/';
          return (
            <div class="relative group">
              <a
                href={item.href}
                class:list={[
                  'nav-link px-4 py-2 text-sm font-medium text-white/80 hover:text-white transition-colors rounded-lg',
                  { 'active text-white': isActive || isHome },
                ]}
              >
                {item.label}
              </a>
              {item.children && (
                <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 min-w-44">
                  <div class="bg-brand-950 border border-white/10 rounded-xl overflow-hidden shadow-xl py-1">
                    {item.children.map((child) => (
                      <a
                        href={child.href}
                        class="block px-4 py-2.5 text-sm text-white/70 hover:text-white hover:bg-white/5 transition-colors"
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </nav>

      <!-- CTA + Theme toggle + Mobile toggle -->
      <div class="flex items-center gap-3">
        <!-- Theme toggle -->
        <button
          id="theme-toggle"
          class="p-2 text-white/80 hover:text-white rounded-lg hover:bg-white/10 transition-colors"
          aria-label="Ganti tema"
        >
          <svg id="icon-sun" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
          </svg>
          <svg id="icon-moon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>

        <a
          href="/donasi"
          class="hidden sm:inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold bg-gold-500 hover:bg-gold-400 text-stone-950 rounded-lg transition-colors"
        >
          Donasi
        </a>

        <!-- Hamburger -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden p-2 text-white/80 hover:text-white rounded-lg hover:bg-white/10 transition-colors"
          aria-label="Buka menu"
          aria-expanded="false"
        >
          <svg id="icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden bg-brand-950 border-t border-white/10"
  >
    <nav class="container-site py-4 flex flex-col gap-1" aria-label="Menu mobile">
      {navItems.map((item) => (
        <div>
          <a
            href={item.href}
            class="block px-4 py-3 text-white/80 hover:text-white hover:bg-white/5 rounded-lg transition-colors font-medium"
          >
            {item.label}
          </a>
          {item.children && (
            <div class="pl-4 flex flex-col gap-0.5">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class="block px-4 py-2 text-sm text-white/60 hover:text-white/90 hover:bg-white/5 rounded-lg transition-colors"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
      <div class="pt-2 border-t border-white/10 mt-2">
        <a
          href="/ibadah"
          class="flex items-center justify-center gap-2 px-4 py-3 text-sm font-medium bg-gold-500 hover:bg-gold-400 text-stone-950 rounded-xl transition-colors"
        >
          Jadwal Ibadah
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const btn = document.getElementById('mobile-menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const iconOpen = document.getElementById('icon-open')!;
  const iconClose = document.getElementById('icon-close')!;

  // Scroll: make header solid. On pages without a hero, always keep it solid.
  const hasHero = document.querySelector('.hero') !== null;

  function updateHeader() {
    if (!hasHero || window.scrollY > 40) {
      header.classList.add('header-solid');
    } else {
      header.classList.remove('header-solid');
    }
  }
  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();

  // Mobile menu toggle
  btn.addEventListener('click', () => {
    const isOpen = !menu.classList.contains('hidden');
    menu.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
    iconOpen.classList.toggle('hidden', !isOpen);
    iconClose.classList.toggle('hidden', isOpen);
  });

  // Theme toggle
  const themeBtn = document.getElementById('theme-toggle')!;
  const iconSun  = document.getElementById('icon-sun')!;
  const iconMoon = document.getElementById('icon-moon')!;

  function applyTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
    iconSun.classList.toggle('hidden', theme === 'light');
    iconMoon.classList.toggle('hidden', theme === 'dark');
  }

  const saved = localStorage.getItem('theme') ?? 'light';
  applyTheme(saved);

  themeBtn.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme') ?? 'light';
    applyTheme(current === 'dark' ? 'light' : 'dark');
  });
</script>
